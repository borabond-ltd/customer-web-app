{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:sandbox": "NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1 BACKEND_URL=http://localhost:9000 NEXT_PUBLIC_AUTH_PROVIDER=google NEXT_PUBLIC_PERSONA_ENVIRONMENT=sandbox next dev --turbopack",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "node scripts/build-production.js",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "prepare-production": "node scripts/prepare-production.js",
    "prepare-screenshots": "node scripts/prepare-screenshots.js",
    "cleanup-production": "node scripts/cleanup-production.js",
    "audit": "npm audit --audit-level moderate",
    "audit:lighthouse": "node scripts/lighthouse-audit.js",
    "clean": "rm -rf .next out dist",
    "preview": "next build && next start"
  },
