# API — api-gateway `/api/v1` (required)
NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1
BACKEND_URL=http://localhost:9000

# Optional alias; if unset, NEXT_PUBLIC_API_URL is used for all routes including password reset.
# NEXT_PUBLIC_CORE_API_URL=http://localhost:9000/api/v1

# Google Identity Services (required for Google sign-in)
NEXT_PUBLIC_AUTH_PROVIDER=google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Persona (optional)
NEXT_PUBLIC_PERSONA_ENVIRONMENT=sandbox
